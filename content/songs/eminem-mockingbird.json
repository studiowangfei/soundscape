      "id": "eminem-mockingbird-g1",
      "type": "background",
      "headline": "Eminem's own words: 'probably the most emotional song I ever wrote'",
      "snippet": "Eminem wrote \"Mockingbird,\" a track on his 2004 album Encore, for his daughter Hailie and his niece Alaina. He has said that when their mom was on the run, the girls couldn't understand what was happening. Someone who had always been part of their lives had suddenly disappeared. He isn't a great talker, so he wrote the song to explain it to them. He calls it probably the most emotional song he ever wrote.",
      "context": "Eminem describing the song in a quote on Genius.",
      "source": {
        "name": "genius.com",
        "platform": "web"
      },
      "url": "https://genius.com/Eminem-mockingbird-lyrics",
      "sourceDate": null
    },
